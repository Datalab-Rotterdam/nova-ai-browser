{
  "name": "@datalabrotterdam/nova-ai-browser",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @datalabrotterdam/nova-ai-browser-extension",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "fixtures": "node test/serve-fixtures.mjs",
    "test:e2e": "npm run build && playwright test",
    "vendor:host": "node scripts/vendor-host.mjs",
    "build:store": "npm run build:store -w @datalabrotterdam/nova-ai-browser-extension",
    "package:extension": "npm run build:store && node scripts/package-extension.mjs",
    "publish:chrome": "chrome-webstore-upload --source release/nova-ai-browser-extension.zip"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "chrome-webstore-upload-cli": "^4.0.2",
    "semantic-release": "^25.0.9",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "version": "0.1.0"
}
