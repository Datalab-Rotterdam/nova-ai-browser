{
  "branches": [
    "main"
  ],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    "@semantic-release/changelog",
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "node scripts/set-version.mjs \"${nextRelease.version}\" && npm install --package-lock-only --ignore-scripts --no-audit --no-fund && npm run package:extension",
        "publishCmd": "npm run publish:chrome"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": [
          "CHANGELOG.md",
          "package.json",
          "package-lock.json",
          "packages/*/package.json"
        ],
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "successComment": false,
        "failCommentCondition": false,
        "releasedLabels": false,
        "assets": [
          {
            "path": "release/nova-ai-browser-extension.zip",
            "name": "nova-ai-browser-extension-${nextRelease.version}.zip",
            "label": "Nova AI browser extension (Chrome Web Store package)"
          }
        ]
      }
    ]
  ]
}
